{
  "name": "commently/tag-subscriptions",
  "description": "API for subscribing to tags; integrates with custom-frontend feed filter",
  "type": "flarum-extension",
  "version": "1.0.0",
  "license": "MIT",
  "require": {
    "flarum/core": "^1.8",
    "flarum/tags": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Commently\\TagSubscriptions\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Tag Subscriptions",
      "category": "feature",
      "icon": {
        "name": "fas fa-bookmark",
        "backgroundColor": "#3b82f6",
        "color": "#fff"
      }
    }
  }
}
