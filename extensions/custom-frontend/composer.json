{
    "name": "commently/custom-frontend",
    "description": "Custom forum frontend with Discussions and Posts controllers, Turbo-ready",
    "type": "flarum-extension",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "flarum/core": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Commently\\CustomFrontend\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Custom Frontend",
            "category": "feature",
            "icon": {
                "name": "fas fa-paint-brush",
                "backgroundColor": "#0ea5e9",
                "color": "#fff"
            }
        }
    }
}
